# Backend Environment Configuration Template
# Copy to backend/.env for local development

APP_NAME="LSR Platform Scrutiny API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Settings (Milestone 1)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# AI Provider Settings (Milestone 4)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-placeholder"
GEMINI_MODEL="gemini-3.8-flash"
