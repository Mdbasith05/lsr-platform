# ==============================================================================
# LSR Platform - Production Environment Template (.env.production.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` on your production deployment server.
# 2. Populate all credentials with high-entropy production secrets.
# 3. Ensure this file is never checked into source control (chmod 600 .env).
# ==============================================================================

# --- Application Runtime ---
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["https://app.lsrplatform.in", "https://lsrplatform.in"]

# --- Supabase Platform Configuration ---
# Project URL from Supabase Project Settings > API
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Secret / Service Role Key (Required by Backend for Admin Auth & RLS Bypass)
# WARNING: Keep strictly confidential. Never expose to client-side bundles.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Anonymous Publishable Key (Configured in Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_BASE_URL=https://api.lsrplatform.in

# --- PostgreSQL Database (Session Pooler) ---
# Use Supabase Session Pooler (Port 5432) or Transaction Pooler (Port 6543)
# Format: postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<secure-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Google Gemini AI Engine ---
# Gemini API Key for title deed scrutiny, 30-year flow analysis, and clause extraction
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.8-flash

# --- Storage Configuration ---
# Bucket name inside Supabase Storage for encrypted legal deeds
SUPABASE_STORAGE_BUCKET=legal-documents
LOCAL_STORAGE_FALLBACK_DIR=/app/storage
