# ==============================================================================
# Legal Scrutiny Report (LSR) Platform — Root Environment Template
# NOTE: DO NOT place real API keys or secrets in this file or any committed file.
# Copy appropriate sections to frontend/.env.local and backend/.env for local run.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Legal Scrutiny Report Platform"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Supabase (Milestone 1 onwards - placeholder for now)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
APP_NAME="LSR Platform Scrutiny API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Supabase Service & DB (Milestone 1 onwards)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# AI Service (Milestone 4 onwards - placeholder for now)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-placeholder"
GEMINI_MODEL="gemini-3.8-flash"
